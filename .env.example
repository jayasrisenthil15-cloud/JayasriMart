# ==============================================================================
# JayasriMart Environment Configuration Example
# Copy this file or set corresponding system environment variables / properties.
# ==============================================================================

# Database Configuration (H2 File Mode for Local/Production, In-Memory for Tests)
DB_URL=jdbc:h2:file:./data/jayasrimart;AUTO_SERVER=TRUE
DB_USER=sa
DB_PASSWORD=
DB_MAX_POOL_SIZE=10

# Server & Session Settings
PORT=8080
SESSION_TIMEOUT_MINUTES=30
APP_ENV=development

# AI Chatbot Configuration
# Provider options: 'mock' (local canned replies, no network needed) or 'gemini'
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=
